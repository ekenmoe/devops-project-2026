# ============================================================
# GENERAL OS / EDITOR FILES
# ============================================================

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/

# ============================================================
# SECRETS / ENVIRONMENT VARIABLES
# ============================================================

.env
.env.*
!.env.example
!.env.sample

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Secret files - review before committing any credentials
secrets/
private/
credentials/
secrets.yml
secrets.yaml
vault-password-file
.vault_pass

# ============================================================
# TERRAFORM
# ============================================================

# Terraform working directories
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform plans (may contain sensitive data)
*.tfplan
*.plan

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration (may contain credentials)
.terraformrc
terraform.rc

# Local Terraform variable files
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Keep example variable files
!terraform.tfvars.example
!terraform.tfvars.sample
!*.auto.tfvars.example

# ============================================================
# TERRAFORM / OPEN TOFU LOCK FILE
# ============================================================

# DO NOT ignore .terraform.lock.hcl.
# Commit it to pin provider selections consistently.

# ============================================================
# ANSIBLE
# ============================================================

# Ansible retry files
*.retry

# Ansible logs
ansible.log

# Ansible Vault password files
.vault_pass
vault-password-file

# Generated Ansible collections and roles
collections/
roles/

# Keep requirements files that define dependencies
!requirements.yml
!requirements.yaml

